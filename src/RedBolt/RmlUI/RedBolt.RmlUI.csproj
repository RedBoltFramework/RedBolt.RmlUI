<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RedBolt.RmlUI</AssemblyName>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Audio/RedBolt.Audio.csproj" />
    <ProjectReference Include="../Native/RmlUi/RedBolt.Bindings.RmlUi.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Native/Sdl/RedBolt.Bindings.Sdl.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Core/RedBolt.Core.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Generator/Reflection/RedBolt.Generator.Reflection.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RedBoltPlatform" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
    <ProjectReference Include="$(RedBoltSharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj" PrivateAssets="all" AdditionalProperties="$(RedBoltSharpCppManagedProperties)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RedBoltRoot)/src/RedBolt/Core/GlobalUsings.cs" Link="GlobalUsings.cs" Visible="false" />
  </ItemGroup>
</Project>
