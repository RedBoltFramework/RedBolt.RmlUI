    <ApplicationId>org.redbolt.rmlui.samples</ApplicationId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RedBoltExternalAndroidNativeOutput>$(RedBoltNativeOutputRoot)</RedBoltExternalAndroidNativeOutput>
    <!-- </redbolt-generated name="android-project-properties"> -->
  </PropertyGroup>
  <ItemGroup>
    <!-- <redbolt-generated name="android-project-items"> -->
    <Compile Include="Program.cs" />
