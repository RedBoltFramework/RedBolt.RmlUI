<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <!-- <redbolt-generated name="web-project-properties"> -->
    <AssemblyName>RedBolt.RmlUI.Sample.Web</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RedBoltExternalWebArchive>$(RedBoltNativeBuildDir)/lib/Release/wasm/RedBolt.RmlUI.Native.Web.a</RedBoltExternalWebArchive>
    <RedBoltExternalWebPInvokeModules>RedBolt.Native.RmlUi</RedBoltExternalWebPInvokeModules>
    <!-- </redbolt-generated name="web-project-properties"> -->
  </PropertyGroup>
  <ItemGroup>
    <!-- <redbolt-generated name="web-project-items"> -->
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../RmlUI/RedBolt.RmlUI.csproj" />
    <ProjectReference Include="../../../../../RedBolt/src/RedBolt/Audio/RedBolt.Audio.csproj" />
    <Compile Include="../AdvancedUI/**/*.cs" Link="Samples/RedBoltRmlUI/AdvancedUI/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../HelloRmlUI/**/*.cs" Link="Samples/RedBoltRmlUI/HelloRmlUI/%(RecursiveDir)%(Filename)%(Extension)" />
    <RedBoltWebResourcePackage Include="RedBolt.RmlUI.CoreData" SourceDirectory="../../../../bin/CoreData.RmlUI" />
    <RedBoltWebResourcePackage Include="RedBolt.RmlUI.SampleData" SourceDirectory="../../../../bin/SampleData.RmlUI" />
    <TrimmerRootAssembly Include="RedBolt.RmlUI" />
    <TrimmerRootAssembly Include="RedBolt.Bindings.RmlUi" />
    <!-- </redbolt-generated name="web-project-items"> -->
  </ItemGroup>
  <!-- <redbolt-generated name="web-project-import"> -->
  <Import Project="../../../../../RedBolt/eng/RedBolt.ModuleBuild/WebSample.targets" />
  <!-- </redbolt-generated name="web-project-import"> -->
  <!-- <redbolt-generated name="web-project-targets"> -->
  <!-- </redbolt-generated name="web-project-targets"> -->
</Project>
